# Preventive Shield — first-party only. No Google Safe Browsing / third-party reputation APIs.
# Threat checks use security/data/curated-threats.json + address signals + live probe.

# Optional extra first-party host list (JSON with { "hosts": { "bad.example": "KNOWN_PHISHING" } })
# OWN_THREAT_LIST_PATH=/absolute/path/to/extra-threats.json

# Merge security/data/curated-threats.pt.json into the own list (default on). Set to 0 to disable.
# Exposed on GET /api/health as ownThreatMergePt (true unless this is 0).
# Settings can write this key into .env.local only when NODE_ENV !== "production" (local-dev
# toggle via POST /api/dev/probe-env). That write path never runs in production builds.
# OWN_THREAT_MERGE_PT=1

# Live probe per-hop timeout (ms). Use result-page timing (probe ms) + timeout note to tune.
CHECK_PROBE_TIMEOUT_MS=5000

# In-memory cache for own threat lookups (ms)
THREAT_CACHE_TTL_MS=3600000

# Rate limit for POST /api/check (per IP, sliding window)
CHECK_RATE_LIMIT=30
CHECK_RATE_WINDOW_MS=60000
# Soft notice when personalListBlocked:true is accepted (no URL).
# GET /api/health echoes personalHintLogEnabled (true unless value is exactly "0"):
#   unset → true (notice on)
#   CHECK_PERSONAL_HINT_LOG=0 → false (silence)
#   CHECK_PERSONAL_HINT_LOG=1 → true (notice on)
# CHECK_PERSONAL_HINT_LOG=0

# Optional ops echo of timing-schema-invalid counters on GET /api/health (no URL).
# Only exact "1" enables; unset/0 omit timingSchemaFailCounts from the JSON.
#   CHECK_TIMING_SCHEMA_FAIL_HEALTH=1 → include { ambiguousAbsent, ambiguousBoolean }
# CHECK_TIMING_SCHEMA_FAIL_HEALTH=1

# Public site URL for metadata + magic-link redirects.
# Local: http://localhost:3000. Production (Cloudflare): https://your.domain (no trailing slash).
# See docs/PRODUCTION_HOSTING.md — set before `npm run deploy:cloudflare` after the custom domain is live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare deploy (optional local):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=   # CI; or use: npx wrangler login

# Production health smoke / CI monitor (optional):
# HEALTH_BASE_URL=https://your.domain
# GitHub Actions variable PRODUCTION_HEALTH_URL=https://your.domain

# Optional account sync for personal block/trust lists only (shield-lists-v1).
# Default off until ready to ship. GET /api/health echoes accountSyncEnabled.
# ACCOUNT_SYNC_ENABLED=1
# On Cloudflare Workers (wrangler vars) ACCOUNT_SYNC_REQUIRE_TURSO=1 — sync stays off without Turso.
# ACCOUNT_SYNC_REQUIRE_TURSO=1
# AUTH_MAGIC_SECRET=change-me-long-random
# AUTH_FROM_EMAIL=noreply@example.com
# LISTS_ENC_KEY=change-me-lists-at-rest
# Production mailer (one required in NODE_ENV=production): Resend or Postmark.
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# Dev-only: return magic URL in JSON (never in production — ignored when NODE_ENV=production).
# ACCOUNT_SYNC_DEV_RETURN_LINK=1
# ACCOUNT_SYNC_STORE_PATH=  # default: data/account-sync/store.json (local/tests only)
# Workers / multi-instance: Turso/libsql required when ACCOUNT_SYNC_REQUIRE_TURSO=1 (no file fallback).
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Cloud list caps (PUT /api/sync/lists → 413 when exceeded).
# ACCOUNT_SYNC_MAX_ENTRIES=2000
# ACCOUNT_SYNC_MAX_BYTES=512000

# Desktop app (desktop-app/): poll WEBSITE_CHECK_URL/api/health this often (ms, min 5000).
# Prefer production origin after `npm run production:origin` (shared/production-site.json).
# Override with WEBSITE_CHECK_URL; local default is http://localhost:3000.
# If both run together and desktop UI also wants :3000, set desktop UI_PORT to another port (e.g. 3010).
# WEBSITE_HEALTH_POLL_MS=15000
# WEBSITE_CHECK_URL=http://localhost:3000