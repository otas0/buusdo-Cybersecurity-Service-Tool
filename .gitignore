# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# listing assert debug keep (SHIELD_LISTING_KEEP_TEMP=1)
/tests/fixtures/listing-mirror-live-temp.json

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment (.env.local from probe-env / Settings — never commit)
.env*
!.env.example

# runtime server caches (head-skip, env-overrides.env fallback when .env.local denied)
/security/data/runtime/*
!/security/data/runtime/.gitkeep

# optional account sync file store (users / sessions / encrypted list blobs)
/data/account-sync/

# evaluation diff markdown (CI / local)
/evaluation/diff.md

# Playwright optional screenshots (keep folder via .gitkeep)
/playwright/output/*
!/playwright/output/.gitkeep
/playwright/report/
/test-results/
/playwright-report/

# TypeScript incremental cache
*.tsbuildinfo

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
# Cloudflare / vinext local state
.mf/
.dev.vars
/outputs/
/work/