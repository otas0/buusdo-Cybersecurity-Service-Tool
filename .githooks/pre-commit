#!/usr/bin/env sh
# Daily pre-commit: OpenAPI / schema copies + home-continue stamp + extension tokens.
# Install once: npm run hooks:install
set -e
cd "$(git rev-parse --show-toplevel)"
npm run openapi:check || {
  echo "hint: openapi copies drifted — run: npm run openapi:sync" >&2
  exit 1
}
npm run sync:home-continue-stamp:check || {
  echo "hint: stamp drifted — run: npm run sync:home-continue-stamp" >&2
  exit 1
}
npm run sync:extension-tokens:check || {
  echo "" >&2
  echo "╔══════════════════════════════════════════════════════════════════╗" >&2
  echo "║  FAIL: extension/shared/tokens.css drifted from shared/tokens.css ║" >&2
  echo "║  Fix:  npm run sync:extension-tokens                              ║" >&2
  echo "║  Then: git add extension/shared/tokens.css && re-commit           ║" >&2
  echo "╚══════════════════════════════════════════════════════════════════╝" >&2
  exit 1
}
# Soft-live streak bumps are CI artifacts only — refuse streak>0 in the index.
node scripts/assert-soft-live-hash-streak-baseline.mjs --index || {
  echo "hint: reset baseline — node scripts/bump-soft-live-hash-streak.mjs --reset && git add ci/soft-live-hash-streak.json" >&2
  exit 1
}
# In-view outcome is runtime-only (gitignored) — refuse if staged accidentally.
if git diff --cached --name-only -- ci/soft-live-hash-inview-outcome.json | grep -q .; then
  echo "refuse: do not commit ci/soft-live-hash-inview-outcome.json (CI runtime; see .gitignore)" >&2
  echo "hint: git reset HEAD -- ci/soft-live-hash-inview-outcome.json" >&2
  exit 1
fi
