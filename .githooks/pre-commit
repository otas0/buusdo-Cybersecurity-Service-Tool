#!/usr/bin/env sh
# Daily pre-commit: OpenAPI / schema copies + home-continue stamp + extension tokens.
# Install once: npm run hooks:install
set -e
cd "$(git rev-parse --show-toplevel)"
npm run openapi:check || {
  echo "hint: openapi copies drifted — run: npm run openapi:sync" >&2
  exit 1
}
npm run sync:home-continue-stamp:check || {
  echo "hint: stamp drifted — run: npm run sync:home-continue-stamp" >&2
  exit 1
}
npm run sync:extension-tokens:check || {
  echo "" >&2
  echo "╔══════════════════════════════════════════════════════════════════╗" >&2
  echo "║  FAIL: extension/shared/tokens.css drifted from shared/tokens.css ║" >&2
  echo "║  Fix:  npm run sync:extension-tokens                              ║" >&2
  echo "║  Then: git add extension/shared/tokens.css && re-commit           ║" >&2
  echo "╚══════════════════════════════════════════════════════════════════╝" >&2
  exit 1
}
