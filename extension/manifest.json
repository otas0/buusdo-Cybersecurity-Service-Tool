{
  "manifest_version": 3,
  "name": "buusdo Cybersecurity Service Tool",
  "short_name": "buusdo",
  "version": "0.1.0",
  "description": "buusdo Cybersecurity Service Tool. Block known trackers and flag phishing-like URLs. EN / pt-PT. Storage defaults to off.",
  "homepage_url": "https://buusdocst.mtsu.workers.dev",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "optional_permissions": [
    "declarativeNetRequestFeedback",
    "clipboardRead"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:3001/*",
    "https://buusdocst.mtsu.workers.dev/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "buusdo Cybersecurity Service Tool",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/toast.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tracker_blocklist",
        "enabled": true,
        "path": "rules/tracker_blocklist.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/toast.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  }
}
