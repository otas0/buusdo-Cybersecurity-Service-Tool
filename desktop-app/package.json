{
  "name": "portugal-cp-desktop-app",
  "version": "0.2.0",
  "private": true,
  "description": "buusdo Cybersecurity Service Tool desktop — scan this computer, ask maximum block, enforce via personal list + local proxy. Launcher + system browser.",
  "main": "src/launcher.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "launch": "node src/launcher.js",
    "install:silent": "node src/launcher.js --install",
    "mvp": "npm run install:silent && node src/launcher.js",
    "pack:macos": "bash packaging/macos/build-app.sh",
    "pack:linux": "bash packaging/linux/build-deb.sh",
    "pack:windows-stage": "bash packaging/windows/stage-nsis.sh",
    "electron": "electron electron-main.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "optionalDependencies": {
    "systray2": "^2.1.4"
  },
  "peerDependencies": {
    "electron": "*"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
}