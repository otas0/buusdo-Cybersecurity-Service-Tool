{
  "$schema": "node_modules/wrangler/config-schema.json",
  // buusdo Cybersecurity Service Tool — Cloudflare Workers (vinext).
  // Set CLOUDFLARE_ACCOUNT_ID in the environment, or uncomment account_id below.
  // "account_id": "YOUR_ACCOUNT_ID",
  // workers.dev URL = https://buusdocst.<account-subdomain>.workers.dev
  // Staging: `npx wrangler deploy --env staging` (or vinext equivalent) → Worker name buusdocst-staging.
  // Never put ACCOUNT_SYNC_ENABLED=1 or ACCOUNT_SYNC_DEV_RETURN_LINK on the top-level (prod) vars.
  "name": "buusdocst",
  "compatibility_date": "2025-10-01",
  // nodejs_compat comes from vite.config.ts cloudflare plugin (do not duplicate here — API 10021).
  // Main entry is provided by @cloudflare/vite-plugin + vinext at build/deploy time.
  // Do not set "main" here when deploying via: npx @vinext/cloudflare deploy
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    // Non-secret defaults only. Secrets → `wrangler secret put NAME`
    // Account sync product cancelled — keep off on every Worker (see security/account-sync/enabled.ts).
    "ACCOUNT_SYNC_ENABLED": "0",
    "ACCOUNT_SYNC_REQUIRE_TURSO": "1"
  },
  "env": {
    "staging": {
      // Separate Worker — secrets via `wrangler secret put … --env staging`
      "name": "buusdocst-staging",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        // Same as prod — Account sync cancelled (no DEV_RETURN_LINK).
        "ACCOUNT_SYNC_ENABLED": "0",
        "ACCOUNT_SYNC_REQUIRE_TURSO": "1"
      }
    }
  }
}